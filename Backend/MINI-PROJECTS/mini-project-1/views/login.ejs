<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini-Project-1</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        div{
            box-shadow: 0 0 20px aqua;
        }
        h1{
            font-weight: 900;
            font-size: 40px;
            color: transparent;
            -webkit-text-stroke-color: white;
            -webkit-text-stroke-width: 1px;
            text-decoration: underline;
            text-decoration-thickness: 5px;
            text-decoration-style: dotted;
            text-decoration-color: white;
        }
    </style>
</head>
<body class="flex justify-center items-center h-screen bg-black text-white">
    <div class="bg-zinc-900 rounded-2xl p-3">
        <h1 class="text-2xl font-sold text-cyan-500 text-center py-2 capitalize">Create an account</h1>
        <form 
        action="/login" 
        method="post"
        class="p-10 text-white bg-gray-500 flex flex-col justify-center gap-5 rounded-2xl">
            <input type="email" name="email" id="email" placeholder="email" class="w-100 py-2 px-3 bg-gray-400 text-black outline-0 rounded-xl placeholder:text-black focus-within:border-3 focus-within:border-blue-800 focus-within:bg-white" required>
            <input type="password" name="password" id="password" placeholder="password" class="w-100 py-2 px-3 bg-gray-400 text-black outline-0 rounded-xl placeholder:text-black focus-within:border-3 focus-within:border-blue-800 focus-within:bg-white" required>
            <button class="bg-blue-500 text-white w-full p-3 rounded-2xl hover:-translate-y-2 hover:bg-green-500 hover:font-bold transition-all duration-300"  type="submit">Login</button>
        </form>
        <p class="text-center">if you already have an account then, <a href="/signup">Signup</a></p>
    </div>
</body>
</html>