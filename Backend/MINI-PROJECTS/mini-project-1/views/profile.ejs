<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini-Project-1</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="bg-black min-h-screen w-full text-white px-20 py-10">
    <div class="w-full flex justify-end">
      <a
        href="/logout"
        class="bg-red-500 rounded-md px-3 py-1 text-sm hover:bg-red-800"
        >Logout</a
      >
    </div>
    <h3 class="font-light text-white text-3xl">
      Hello,
      <span class="text-violet-500 underline underline-offset-4 italic"
        ><%= user.name%></span
      >👋
    </h3>
    <p class="text-zinc-400 text-xs">You can create a post</p>

    <form action="/post" method="post" class="group">
      <textarea
        placeholder="what's on your mind ?"
        name="content"
        class="outline-none p-3 text-sm w-1/3 block border-1 border-gray-600 rounded-sm resize my-1 group-focus-within:border-blue-400"
      ></textarea>
      <input
        type="Submit"
        class="px-3 py-2 bg-blue-500 rounded-md block text-sm mt-2 hover:bg-green-500 transition-all duration-300"
        value="Create New Post"
      />
    </form>

    <div class="posts mt-20">
      <h3 class="text-zinc-400">Your Posts.</h3>
      <div class="postcontainer mt-5">
        <% user.posts.reverse().forEach(function(post){ %>
        <div
          class="post w-1/3 p-4 mb-2 rounded-md bg-zinc-800 border-2 border-zinc-700"
        >
          <h4 class="text-blue-500 mb-2">@<%= user.username%></h4>
          <p class="text-sm tracking-tight">
            <%= post.content %>
          </p>
          <small class="mt-4 inline-block">👍<%= post.likes.length %> likes</small>
          <div class="flex gap-4 -mt-1">
            <a href='/like/<%= post._id %>' class="text-blue-500">
              <%= post.likes.indexOf(user._id) === -1 ? "like" : "Unlike" %>
            </a>  
            <a href="/edit/<%= post._id %>" class="text-zinc-600">Edit</a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </body>
</html>
