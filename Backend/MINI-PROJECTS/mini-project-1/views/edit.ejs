<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini-Project-1</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="bg-black min-h-screen w-full text-white px-20 py-10">
    <form action="/update/<%= post._id %>" method="post" class="group">
      <textarea
        placeholder="what's on your mind ?"
        name="content"
        class="outline-none p-3 text-sm w-100 block border-1 border-gray-600 rounded-sm resize my-1 group-focus-within:border-blue-400"
      ><%= post.content %></textarea>
      <input
        type="Submit"
        class="px-3 py-2 bg-yellow-500 text-black rounded-md block text-sm mt-2 hover:bg-green-500 transition-all duration-300"
        value="Update Post"
      />
    </form>
  </body>
</html>
